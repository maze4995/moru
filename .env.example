# Local emulator only. No existing project or credentials are used.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-moru.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-moru
FIREBASE_PROJECT_ID=demo-moru
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
OWNER_UID=local-owner
APP_ORIGIN=http://localhost:3000
# Set true only after the independent server worker/scheduler is running.
SCHEDULER_ENABLED=false
EMAIL_MODE=test
# EMAIL_MODE=live requires scheduler, verified Firebase email and opt-in.
RESEND_API_KEY=
EMAIL_FROM=
# OAuth is separate from Firebase Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
# 32 random bytes encoded as base64. Server only. Never use NEXT_PUBLIC_.
TOKEN_ENCRYPTION_KEY=
# Dots local bridge; prepare only after approving the connection.
# Server-only. Enabling access in app settings is also required.
MORU_DOTS_TOKEN=
# Optional production tunnel target. Configure BOTH only after deployment.
# The production token must equal MORU_DOTS_TOKEN on the deployed server.
MORU_DOTS_PRODUCTION_ORIGIN=
MORU_DOTS_PRODUCTION_TOKEN=
# Hosting secret store only (e.g. Vercel Sensitive production variable).
# Never set a real service account credential in an Emulator environment.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Vercel Node 22: enable the ESM loading required by Firebase Admin dependencies.
# Configure in Vercel Production, not needed for local Node 22.22 defaults.
# NODE_OPTIONS=--experimental-require-module
# Production: Application Default Credentials; never commit a service key.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/moru-service-account.json

# HTTPS MCP: enable only after owner approval; uses APP_ORIGIN as canonical issuer.
MORU_MCP_ENABLED=false
